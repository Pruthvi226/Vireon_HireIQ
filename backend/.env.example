# Local development only. Copy to backend/.env; Docker reads the root .env instead.
APP_ENV=local
# Supply a persistent secret; leaving empty uses a random per-process development key.
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=15
VIREON_SQLITE_JOURNAL_MODE=MEMORY
MAX_RESUME_BYTES=5242880
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_EMBEDDINGS=false
REDIS_URL=
