# Copy to `backend/.env` (gitignored). Loaded on startup before datasource binding.
#
# --- Use MySQL ---
# PowerShell:
#   $env:SPRING_PROFILES_ACTIVE="mysql"
#   $env:DB_PASSWORD="your_mysql_root_password"
#   mvn spring-boot:run
# Or add to this file:
#   SPRING_PROFILES_ACTIVE=mysql
#   DB_PASSWORD=your_mysql_root_password

DB_URL=jdbc:mysql://localhost:3306/ai_interview_coach?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=Pruthvi@2324
SPRING_PROFILES_ACTIVE=mysql

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
AI_SERVICE_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173
