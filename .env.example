# Docker Compose deployment defaults
APP_ENV=production
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=15
VIREON_CACHE_TTL_SECONDS=60
VIREON_RATE_LIMIT_PER_MINUTE=240
VIREON_SQLITE_JOURNAL_MODE=WAL
MAX_RESUME_BYTES=5242880
ENABLE_EMBEDDINGS=false
EMBEDDING_MODEL=all-MiniLM-L6-v2
REDIS_URL=
POSTGRES_PASSWORD=
CORS_ALLOWED_ORIGINS=http://localhost:8080
# Optional: sqlite:///absolute/path/vireon_hireiq.sqlite; PostgreSQL is not yet supported.
DATABASE_URL=
